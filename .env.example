# ============================================================
# DIRPOLES-IA - Variables de entorno (plantilla)
# Copiar a .env y completar los valores reales
# ============================================================

# --- Servidor FastAPI ---
HOST=0.0.0.0
PORT=8000
DEBUG=True

# --- Seguridad B2B (cabecera X-API-Key compartida con el monolito PHP) ---
DIRPOLES_IA_API_KEY=cambia_esta_clave_b2b

# --- Conexión a Base de Datos (READ-ONLY) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=dirpoles_ia_reader
DB_PASSWORD=contraseña_segura_lectura
DB_NAME_BUSINESS=dirpoles_business
DB_NAME_SECURITY=dirpoles_security

# --- Proveedor de IA (Google AI Studio) ---
# Si GEMINI_API_KEY está vacía o MOCK_LLM=True, se usa el generador simulado local.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
MOCK_LLM=True

# --- Analítica ---
# Insumos con cantidad menor a este umbral se marcan como stock crítico.
UMBRAL_STOCK_CRITICO_INSUMOS=10
# Repuestos con cantidad menor a este umbral se marcan como bajo stock.
UMBRAL_STOCK_CRITICO_REPUESTOS=5
# Máximo de filas extraídas por colección (1–20000).
LIMITE_REGISTROS=5000

# --- CORS (orígenes permitidos, separados por coma) ---
ALLOWED_ORIGINS=http://localhost,http://localhost:80
