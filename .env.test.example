# ==============================================================================
# DIRPOLES-IA - Plantilla de Configuración para Pruebas de Integración con MySQL
# ==============================================================================
# IMPORTANTE:
# Está terminantemente prohibido utilizar este archivo para apuntar a las bases de
# datos institucionales ('dirpoles_business' o 'dirpoles_security').
#
# El guard de seguridad en 'tests/guard_integracion_bd.py' bloqueará automáticamente
# cualquier ejecución si los nombres de esquemas no contienen 'test' o 'prueba'.
#
# Para ejecutar las pruebas de integración reales:
#   1. Levantar una instancia MySQL/MariaDB de prueba aislada (ej. en Docker o puerto alterno).
#   2. Cargar los esquemas DDL y datos sintéticos provistos por el equipo DIRPOLES-4.
#   3. Exportar las siguientes variables de entorno:
#      export DIRPOLES_TEST_BD=1
#      export DIRPOLES_TEST_DB_HOST=127.0.0.1
#      export DIRPOLES_TEST_DB_PORT=3306
#      export DIRPOLES_TEST_DB_USER=dirpoles_test_user
#      export DIRPOLES_TEST_DB_PASSWORD=clave_test
#      export DIRPOLES_TEST_DB_NAME_BUSINESS=dirpoles_business_test
#      export DIRPOLES_TEST_DB_NAME_SECURITY=dirpoles_security_test
#   4. Ejecutar:
#      PYTHONPATH=. .venv/bin/python -m unittest tests/test_integracion_bd.py
# ==============================================================================

DIRPOLES_TEST_BD=1

# Parámetros de conexión al servidor MySQL de pruebas aislado
DIRPOLES_TEST_DB_HOST=127.0.0.1
DIRPOLES_TEST_DB_PORT=3306
DIRPOLES_TEST_DB_USER=dirpoles_test_user
DIRPOLES_TEST_DB_PASSWORD=clave_segura_de_prueba

# Esquemas de prueba dedicados (DEBEN contener 'test' o 'prueba' en el nombre)
DIRPOLES_TEST_DB_NAME_BUSINESS=dirpoles_business_test
DIRPOLES_TEST_DB_NAME_SECURITY=dirpoles_security_test
